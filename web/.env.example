# Base URL of the Web API. Point at the IIS host before the demo.
VITE_API_BASE_URL=http://localhost:5000/api

# Browser key for the Google Maps JavaScript API, used by the node location
# picker. Enable "Maps JavaScript API", "Geocoding API" and "Places API (New)"
# on the key, and restrict it by HTTP referrer.
VITE_GOOGLE_MAP_API_KEY=
