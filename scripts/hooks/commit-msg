#!/usr/bin/env bash
# Enforce Conventional Commits locally, matching the CI PR-title guard.
set -euo pipefail

MSG_FILE="$1"
FIRST_LINE="$(head -n1 "$MSG_FILE")"

# Merge and revert commits are generated by git; let them through.
case "$FIRST_LINE" in
  Merge*|Revert*|fixup!*|squash!*) exit 0 ;;
esac

PATTERN='^(feat|fix|docs|test|refactor|perf|chore|ci)\((api|web|mobile|auth|user|prosumer|node|slot|resv|qr|view|docs|ci|repo)\): .+'

if ! printf '%s' "$FIRST_LINE" | grep -qE "$PATTERN"; then
  cat <<EOF

  Commit message rejected.

  Got:      $FIRST_LINE
  Expected: <type>(<scope>): <summary>

  Types:  feat fix docs test refactor perf chore ci
  Scopes: api web mobile auth user prosumer node slot resv qr view docs ci repo

  Cite the requirement or rule you are implementing:
    feat(resv): enforce 12-hour cancellation window (BR-07, REQ-RESV AC-5)
    fix(node): block deactivation when active reservations exist (BR-09)

EOF
  exit 1
fi
