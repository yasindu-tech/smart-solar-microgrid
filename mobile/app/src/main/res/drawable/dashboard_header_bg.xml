<?xml version="1.0" encoding="utf-8"?>
<!--
  Drawable    : dashboard_header_bg.xml
  Description : Hero band behind the dashboard greeting. A brand gradient from
                sg_primary into sg_primary_hover with the bottom corners rounded, so
                the content below reads as sitting on the page rather than on a slab.
                References only existing sg_* tokens per ui-design-system.md §22.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:endColor="@color/sg_primary_hover"
        android:startColor="@color/sg_primary"
        android:type="linear" />
    <corners
        android:bottomLeftRadius="@dimen/sg_radius_xl"
        android:bottomRightRadius="@dimen/sg_radius_xl" />
</shape>
