<?xml version="1.0" encoding="utf-8"?>
<!--
  Drawable    : login_bg_wash.xml
  Description : Background for the login screen. A soft vertical wash from sg_primary_soft
                at the top (behind the logo and title) down to the flat sg_bg the rest of
                the app uses, so the card reads as sitting on the page rather than on a
                slab of brand color. References only existing sg_* tokens per
                ui-design-system.md §22.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:centerColor="@color/sg_bg"
        android:centerY="0.45"
        android:endColor="@color/sg_bg"
        android:startColor="@color/sg_primary_soft"
        android:type="linear" />
</shape>
