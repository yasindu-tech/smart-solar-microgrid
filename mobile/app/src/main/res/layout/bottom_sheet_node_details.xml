<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/sg_surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    android:layout_margin="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Drag Handle indicator -->
        <View
            android:layout_width="32dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="@color/sg_border_strong" />

        <!-- Node Header Row: Name & Node ID Chip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvNodeName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/sg_text"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Moratuwa Microgrid Hub" />

            <TextView
                android:id="@+id/tvNodeIdChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_bg"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/sg_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="ND-001" />
        </LinearLayout>

        <!-- Address Line -->
        <TextView
            android:id="@+id/tvNodeAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/sg_text_secondary"
            android:textSize="14sp"
            tools:text="123 Katubedda Rd, Moratuwa" />

        <!-- Node Details Specs Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <!-- Capacity -->
            <TextView
                android:id="@+id/tvNodeCapacity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/sg_text"
                android:textSize="14sp"
                tools:text="Capacity: 250.0 kWh" />

            <!-- Battery Slots -->
            <TextView
                android:id="@+id/tvNodeBatterySlots"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/sg_text"
                android:textSize="14sp"
                tools:text="Battery Slots: 8" />
        </LinearLayout>

        <!-- Spec Row 2: Type Tag & Distance -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvNodeType"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/sg_text"
                android:textSize="14sp"
                tools:text="Type: AC" />

            <TextView
                android:id="@+id/tvNodeDistance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/sg_text_secondary"
                android:textSize="14sp"
                android:visibility="visible"
                tools:text="1.20 km away" />
        </LinearLayout>

        <!-- Action Button: Book Here -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBookHere"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/map_book_here"
            android:textAllCaps="false"
            app:cornerRadius="8dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
