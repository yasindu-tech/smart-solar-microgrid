<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sg_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/sg_space_6">

        <!-- Offline banner (hidden when online) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardOfflineBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/sg_space_4"
            android:visibility="gone"
            app:cardBackgroundColor="@color/sg_warning_soft"
            app:cardCornerRadius="@dimen/sg_radius_md"
            app:cardElevation="0dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/sg_space_3"
                android:text="@string/offline_banner_text"
                android:textAlignment="center"
                android:textColor="@color/sg_warning"
                android:textSize="13sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- SunGrid logo -->
        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginBottom="@dimen/sg_space_6"
            android:contentDescription="@string/app_name"
            android:src="@drawable/logo" />

        <!-- Home title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/sg_space_2"
            android:text="@string/prosumer_home_title"
            android:textColor="@color/sg_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Welcome message -->
        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/sg_space_2"
            android:textColor="@color/sg_text"
            android:textSize="18sp" />

        <!-- Role badge -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/sg_space_8"
            android:text="@string/role_prosumer"
            android:textColor="@color/sg_text_secondary"
            android:textSize="14sp" />

        <!-- Placeholder message for D3's dashboard widgets -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/sg_space_4"
            app:cardBackgroundColor="@color/sg_primary_soft"
            app:cardCornerRadius="@dimen/sg_radius_md"
            app:cardElevation="0dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/sg_space_4"
                android:text="@string/home_placeholder"
                android:textAlignment="center"
                android:textColor="@color/sg_primary"
                android:textSize="14sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Navigation buttons (My Profile, My Bookings, Map) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProfile"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="@dimen/sg_space_4"
            android:text="@string/nav_profile"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:backgroundTint="@color/sg_surface"
            app:cornerRadius="@dimen/sg_radius_md"
            app:strokeColor="@color/sg_border"
            app:strokeWidth="1dp"
            android:textColor="@color/sg_text" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBookings"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="@dimen/sg_space_4"
            android:text="@string/nav_bookings"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:backgroundTint="@color/sg_surface"
            app:cornerRadius="@dimen/sg_radius_md"
            app:strokeColor="@color/sg_border"
            app:strokeWidth="1dp"
            android:textColor="@color/sg_text" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMap"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="@dimen/sg_space_8"
            android:text="@string/nav_map"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:backgroundTint="@color/sg_surface"
            app:cornerRadius="@dimen/sg_radius_md"
            app:strokeColor="@color/sg_border"
            app:strokeWidth="1dp"
            android:textColor="@color/sg_text" />

        <!-- Logout button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="@dimen/sg_space_4"
            android:text="@string/logout_btn"
            android:textAllCaps="false"
            android:textColor="@color/sg_danger"
            app:cornerRadius="@dimen/sg_radius_md"
            app:strokeColor="@color/sg_danger" />

    </LinearLayout>
</ScrollView>
