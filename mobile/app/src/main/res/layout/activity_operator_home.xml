<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sg_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/sg_space_6">

    <!-- SunGrid logo -->
    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginBottom="@dimen/sg_space_6"
        android:contentDescription="@string/app_name"
        android:src="@drawable/logo" />

    <!-- Home title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/sg_space_2"
        android:text="@string/operator_home_title"
        android:textColor="@color/sg_secondary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- Welcome message -->
    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/sg_space_2"
        android:textColor="@color/sg_text"
        android:textSize="18sp" />

    <!-- Role badge -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/sg_space_8"
        android:text="@string/role_operator"
        android:textColor="@color/sg_text_secondary"
        android:textSize="14sp" />

    <!-- Placeholder message -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/sg_space_8"
        app:cardBackgroundColor="@color/sg_secondary_soft"
        app:cardCornerRadius="@dimen/sg_radius_md"
        app:cardElevation="0dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/sg_space_4"
            android:text="@string/home_placeholder"
            android:textAlignment="center"
            android:textColor="@color/sg_secondary"
            android:textSize="14sp" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Logout button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogout"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/logout_btn"
        android:textAllCaps="false"
        android:textColor="@color/sg_danger"
        app:cornerRadius="@dimen/sg_radius_md"
        app:strokeColor="@color/sg_danger" />

</LinearLayout>
