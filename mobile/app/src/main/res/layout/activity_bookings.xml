<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sg_primary_soft"
    android:orientation="vertical">

    <!-- Top App Bar / Header -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/sg_primary"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/sg_white"
        app:title="@string/bookings_title"
        app:titleTextColor="@color/sg_white" />

    <!-- Progress Indicator Overlay (matches activity_create_booking.xml) -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:indeterminateTint="@color/sg_primary"
        android:visibility="gone" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/sg_primary_soft"
            android:orientation="vertical"
            android:paddingStart="@dimen/sg_space_4"
            android:paddingTop="@dimen/sg_space_4"
            android:paddingEnd="@dimen/sg_space_4">

            <!-- Offline Banner -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardOfflineBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/sg_space_3"
                android:visibility="gone"
                app:cardBackgroundColor="@color/sg_warning_soft"
                app:cardCornerRadius="@dimen/sg_radius_md"
                app:cardElevation="0dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/sg_space_3"
                    android:text="@string/offline_banner_text"
                    android:textAlignment="center"
                    android:textColor="@color/sg_warning_text"
                    android:textSize="13sp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Search Bar -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tlSearch"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/sg_space_3"
                app:boxBackgroundColor="@color/sg_surface"
                app:boxCornerRadiusBottomEnd="@dimen/sg_radius_lg"
                app:boxCornerRadiusBottomStart="@dimen/sg_radius_lg"
                app:boxCornerRadiusTopEnd="@dimen/sg_radius_lg"
                app:boxCornerRadiusTopStart="@dimen/sg_radius_lg"
                app:boxStrokeColor="@color/sg_border"
                app:endIconMode="clear_text"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_search"
                app:startIconTint="@color/sg_text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSearch"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="@string/bookings_search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:textColor="@color/sg_text"
                    android:textColorHint="@color/sg_text_disabled"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Filter Chips Row -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/sg_space_3"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterAll"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/bookings_filter_all"
                        android:textColor="@color/sg_text"
                        app:chipBackgroundColor="@color/sg_surface"
                        app:chipStrokeColor="@color/sg_border"
                        app:chipStrokeWidth="1dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterPending"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bookings_filter_pending"
                        android:textColor="@color/sg_text"
                        app:chipBackgroundColor="@color/sg_surface"
                        app:chipStrokeColor="@color/sg_border"
                        app:chipStrokeWidth="1dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterApproved"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bookings_filter_approved"
                        android:textColor="@color/sg_text"
                        app:chipBackgroundColor="@color/sg_surface"
                        app:chipStrokeColor="@color/sg_border"
                        app:chipStrokeWidth="1dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterCompleted"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bookings_filter_completed"
                        android:textColor="@color/sg_text"
                        app:chipBackgroundColor="@color/sg_surface"
                        app:chipStrokeColor="@color/sg_border"
                        app:chipStrokeWidth="1dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterCancelled"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bookings_filter_cancelled"
                        android:textColor="@color/sg_text"
                        app:chipBackgroundColor="@color/sg_surface"
                        app:chipStrokeColor="@color/sg_border"
                        app:chipStrokeWidth="1dp" />

                </com.google.android.material.chip.ChipGroup>

            </HorizontalScrollView>

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/layoutEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/sg_space_8"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bookings_empty_title"
                    android:textColor="@color/sg_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sg_space_2"
                    android:text="@string/bookings_empty_subtitle"
                    android:textAlignment="center"
                    android:textColor="@color/sg_text_muted"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Bookings List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvBookings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="@dimen/sg_space_6" />

        </LinearLayout>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>
