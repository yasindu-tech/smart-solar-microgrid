<?xml version="1.0" encoding="utf-8"?>
<!--
  Layout      : item_booking.xml
  Description : Card representation of a single reservation in "My Bookings" list.
                Displays Reservation ID, Node Name, Slot Date/Time, Requested Energy,
                and Status Chip styled with SunGrid tokens.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/sg_space_3"
    android:backgroundTint="@color/sg_white"
    app:cardBackgroundColor="@color/sg_white"
    app:cardCornerRadius="@dimen/sg_radius_lg"
    app:cardElevation="0dp"
    app:strokeColor="@color/sg_primary_soft"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/sg_space_4">

        <!-- Top row: Reservation ID and Status Chip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvReservationId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/sg_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/sg_space_2"
                android:background="@drawable/badge_bg"
                android:paddingStart="@dimen/sg_space_3"
                android:paddingTop="@dimen/sg_space_1"
                android:paddingEnd="@dimen/sg_space_3"
                android:paddingBottom="@dimen/sg_space_1"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/sg_space_3"
            android:layout_marginBottom="@dimen/sg_space_3"
            android:background="@color/sg_border" />

        <!-- Middle row: Accent stripe + Details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <View
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/sg_space_3"
                android:background="@drawable/accent_stripe_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNodeName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/sg_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSlotTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sg_space_1"
                    android:textColor="@color/sg_text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvEnergy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sg_space_1"
                    android:textColor="@color/sg_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
