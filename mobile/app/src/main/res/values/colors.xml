<?xml version="1.0" encoding="utf-8"?>
<!--
  SunGrid design-system color tokens for Android.

  These must stay numerically identical to the --sg-* custom properties in
  web/src/styles/base.css - see docs/architecture/ui-design-system.md section 22.
  There is no build step that generates one file from the other; if base.css
  changes, update this file by hand in the same PR.
-->
<resources>

    <!-- Brand -->
    <color name="sg_primary">#0067B9</color>
    <color name="sg_primary_hover">#004A86</color>
    <color name="sg_primary_soft">#E8F4FC</color>

    <color name="sg_secondary">#43B02A</color>
    <color name="sg_secondary_hover">#2F861E</color>
    <color name="sg_secondary_soft">#EAF7E7</color>

    <color name="sg_accent">#FFB81C</color>
    <color name="sg_accent_soft">#FFF7DB</color>

    <color name="sg_cyan">#00A6C7</color>
    <color name="sg_cyan_soft">#E0F7FA</color>

    <!-- Semantic -->
    <color name="sg_success">#16A34A</color>
    <color name="sg_success_hover">#15803D</color>
    <color name="sg_success_soft">#DCFCE7</color>
    <color name="sg_success_text">#166534</color>

    <color name="sg_warning">#D97706</color>
    <color name="sg_warning_hover">#B45309</color>
    <color name="sg_warning_soft">#FEF3C7</color>
    <color name="sg_warning_text">#92400E</color>

    <color name="sg_danger">#DC2626</color>
    <color name="sg_danger_hover">#B91C1C</color>
    <color name="sg_danger_soft">#FEE2E2</color>
    <color name="sg_danger_text">#991B1B</color>

    <color name="sg_info">#0284C7</color>
