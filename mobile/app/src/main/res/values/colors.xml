    <!-- Neutrals -->
    <color name="sg_white">#FFFFFF</color>
    <color name="sg_black">#000000</color>

    <color name="sg_bg">#F8FAFC</color>
    <color name="sg_surface">#FFFFFF</color>
    <color name="sg_surface_muted">#F1F5F9</color>
    <color name="sg_surface_hover">#F8FAFC</color>

    <color name="sg_border">#E2E8F0</color>
